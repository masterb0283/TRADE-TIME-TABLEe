generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  ip        String?
  createdAt DateTime @default(now())

  @@map("contact_messages")
  @@index([createdAt])
}

model ProjectView {
  id        String   @id @default(cuid())
  slug      String
  createdAt DateTime @default(now())

  @@map("project_views")
  @@index([slug])
}
